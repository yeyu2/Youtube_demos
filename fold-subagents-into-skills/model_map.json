{
  "default_loop_model": "claude-sonnet-4-5",
  "routes": {
    "fast": {
      "description": "High-noise leaf search, log scanning, and noisy webhook logs",
      "provider": "google",
      "model": "gemini-4-hydrogen",
      "read_only": true,
      "zero_memory": false,
      "max_output_tokens": 600
    },
    "deep": {
      "description": "Isolated security review, independent check, and boundary audit",
      "provider": "anthropic",
      "model": "claude-opus-5.5",
      "read_only": true,
      "zero_memory": true,
      "max_output_tokens": 1200
    }
  }
}
